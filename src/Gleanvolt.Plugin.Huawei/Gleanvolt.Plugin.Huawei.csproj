<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Huawei's SCharger-7KS-S0 and SCharger-22KT-S0 as a Gleanvolt charger plugin, over Modbus TCP: a port of the driver
    built into Gleanvolt up to 1.3 (HuaweiSChargerDriver), on the MIT Gleanvolt.Modbus client.
  -->
  <PropertyGroup>
    <UserSecretsId>gleanvolt-plugin-huawei</UserSecretsId>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gleanvolt.Chargers.Shared\Gleanvolt.Chargers.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gleanvolt.Chargers.Tests" />
  </ItemGroup>

</Project>
