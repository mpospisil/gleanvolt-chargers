<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    What every charger plugin here shares: the host (configuration, the page guarded by Gleanvolt's ticket, the
    connection), the base of a charger source and its status, the page's shell and its common sections (Gleanvolt,
    the recording for testers, the search), the address store, and the transport recording. A plugin keeps only its
    device: how to read and command it, and what its page shows of it.
  -->
  <PropertyGroup>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
    <RootNamespace>Gleanvolt.Chargers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Gleanvolt.Providers.Client" Version="$(GleanvoltSdkVersion)" />
    <PackageReference Include="Gleanvolt.Modbus" Version="$(GleanvoltSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gleanvolt.Chargers.Tests" />
  </ItemGroup>

</Project>
