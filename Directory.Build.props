<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Authors>Martin Pospisil</Authors>
    <Copyright>Copyright (c) 2026 Martin Pospisil</Copyright>

    <!--
      The Gleanvolt SDK every plugin is built on. Charger contract 1.1 (capabilities in the hello) is in 1.3.1 and later.
      Whether a plugin works with a Gleanvolt is decided by the contract's major, not by this.
      1.3.3-local.1 is a local build, not on nuget.org: packed into artifacts/feed from solax-controller's branch
      plugin-culture-fallback at a1e0a54, adding ?culture= (English when a plugin lacks the language) and Words.From.
      Move to the release that carries these changes.
    -->
    <GleanvoltSdkVersion>1.3.3-local.1</GleanvoltSdkVersion>

    <!-- A plugin's own version: 0.0.0-dev in a plain build; the release workflow passes the tag's. -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>
</Project>
