<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <Authors>Martin Pospisil</Authors>
    <Copyright>Copyright (c) 2026 Martin Pospisil</Copyright>

    <!--
      The Gleanvolt SDK every plugin is built on, from nuget.org. Charger contract 1.1 (capabilities in the hello)
      is in 1.3.1 and later. Whether a plugin works with a Gleanvolt is decided by the contract's major, not by this.
      1.3.3-preview.5 (gleanvolt's branch viewer-culture at 0ac8ead): ViewerCulture keeps a page in the viewer's
      language when the charger's poll re-renders it; preview.4 added ?culture= and Words.From. Move to the release
      that follows it.
    -->
    <GleanvoltSdkVersion>1.3.3-preview.5</GleanvoltSdkVersion>

    <!-- A plugin's own version: 0.0.0-dev in a plain build; the release workflow passes the tag's. -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>
</Project>
