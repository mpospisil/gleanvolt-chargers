<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    nuget.org for everything, the Gleanvolt SDK included (Gleanvolt.Providers.*, Gleanvolt.Modbus, MIT). The local
    folder is for an SDK packed from Gleanvolt's own source before it is released: empty in a clone, and in CI.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-sdk" value="artifacts/feed" />
  </packageSources>
  <!--
    The most specific pattern decides which sources a package may come from, so Gleanvolt.* names both: nuget.org, and
    the local folder when it holds a build. With only the folder here, nuget.org would never be asked for the SDK.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
      <package pattern="Gleanvolt.*" />
    </packageSource>
    <packageSource key="local-sdk">
      <package pattern="Gleanvolt.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
