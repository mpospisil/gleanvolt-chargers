<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The go-e Charger (Gemini, Gemini flex, HOMEfix, HOME+, hardware V3 and later) as a Gleanvolt charger plugin, over
    its local HTTP API v2: a port of the driver built into Gleanvolt up to 1.3 (GoeChargerDriver).
  -->
  <PropertyGroup>
    <UserSecretsId>gleanvolt-plugin-goe</UserSecretsId>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <!-- The charger plugin host, from nuget.org: everything but the device. -->
  <ItemGroup>
    <PackageReference Include="Gleanvolt.Chargers.Hosting" Version="$(GleanvoltSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gleanvolt.Plugin.GoE.Tests" />
  </ItemGroup>

</Project>
