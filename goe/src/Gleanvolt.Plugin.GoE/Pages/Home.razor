@page "/"
@implements IDisposable
@inject GoeCharger Charger

@*
    The go-e plugin's page: the shared frame, with the force state, the unit's own ceiling and the firmware.
*@

<PluginFrame Check="CheckAsync">
    <dl id="goe">
        <dt>@PageText.ForceState</dt>
        <dd id="force-state">@(Charger.LastReading?.Mode ?? SharedText.NotSaid.ToString())@(Charger.Paused ? $" ({PageText.PausedByGleanvolt})" : "")</dd>
        <dt>@PageText.Ceiling</dt>
        <dd id="ceiling">@(Charger.DeviceMaxAmps is { } amps ? $"{amps} A" : SharedText.NotSaid.ToString())</dd>
        <dt>@PageText.Firmware</dt>
        <dd id="firmware">@(Charger.Firmware ?? SharedText.NotSaid.ToString())</dd>
    </dl>
</PluginFrame>

@code {
    protected override void OnInitialized() => Charger.Changed += Refresh;

    public void Dispose() => Charger.Changed -= Refresh;

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private Task<string> CheckAsync(DeviceAddress address, byte? unitId) => Charger.CheckAsync(address, CancellationToken.None);
}
