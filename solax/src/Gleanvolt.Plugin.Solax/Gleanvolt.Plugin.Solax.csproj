<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    SolaX's EV chargers (X1/X3-HAC, X1/X3-EVC) as a Gleanvolt charger plugin, over Modbus TCP: a port of the driver
    built into Gleanvolt up to 1.3 (SolaxChargerDriver), on the MIT Gleanvolt.Modbus client.
  -->
  <PropertyGroup>
    <UserSecretsId>gleanvolt-plugin-solax</UserSecretsId>
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <!-- The charger plugin host, from nuget.org: everything but the device. -->
  <ItemGroup>
    <PackageReference Include="Gleanvolt.Chargers.Hosting" Version="$(GleanvoltSdkVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gleanvolt.Plugin.Solax.Tests" />
  </ItemGroup>

</Project>
